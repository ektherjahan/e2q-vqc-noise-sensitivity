    family-names: Himal
    affiliation: "Department of Computer Science and Engineering, Bangladesh University, Dhaka, Bangladesh"
keywords:
  - quantum machine learning
  - variational quantum classifier
  - quantum noise
  - calibration-aware proxy
  - IBM Quantum calibration
  - reproducibility
